# Export these in your shell (the app reads real environment variables; .env is not auto-loaded).
# Nothing here is a secret; there are no API keys.

# SQLite file location (default: data/readiness.db)
READINESS_DB_PATH=data/readiness.db

# Local LLM via Ollama (optional; the app falls back to a rule-based mentor)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=90

# Resume <-> job description matching: tfidf (offline default) | chroma | auto
SEMANTIC_BACKEND=tfidf
